{
  "name": "internal-settlement-token",
  "version": "0.1.0",
  "private": true,
  "description": "Institutional TRC20 settlement-simulation infrastructure for TRON Mainnet. Multi-sig governed, role-gated, allowlist-restricted.",
  "license": "UNLICENSED",
  "scripts": {
    "compile": "tronbox compile",
    "compile:hardhat": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "lint:sol:fix": "solhint 'contracts/**/*.sol' --fix",
    "format:sol": "prettier --write 'contracts/**/*.sol'",
    "audit:slither": "slither . --config-file slither.config.json",
    "audit:gitleaks": "gitleaks detect --source . --redact --config .gitleaks.toml",
    "audit:all": "npm run lint:sol && npm run audit:slither && npm run audit:gitleaks",
    "migrate:shasta": "tronbox migrate --network shasta",
    "migrate:nile": "tronbox migrate --network nile",
    "migrate:mainnet": "tronbox migrate --network mainnet",
    "verify": "node scripts/verify.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^4.9.6",
    "hardhat": "^2.22.0",
    "prettier": "^3.2.0",
    "prettier-plugin-solidity": "^1.3.1",
    "solhint": "^5.0.0",
    "solhint-plugin-prettier": "^0.1.0",
    "solidity-coverage": "^0.8.5",
    "tronbox": "^4.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
