# =============================================================================
#  Internal Settlement Token — environment template
#
#  Copy to `.env` and fill in. NEVER commit `.env` (it's in .gitignore).
#  In production, these values are sourced from KMS / HashiCorp Vault — see
#  docs/security/key_management_policy.md. The signer is selected via
#  SIGNER_BACKEND below.
# =============================================================================

# ---- Signer backend ---------------------------------------------------------
# One of: env | aws_kms | hashicorp_vault
# - env  : read PK_<NETWORK> from this file (development only)
# - aws_kms : sign via AWS KMS asymmetric key (production)
# - hashicorp_vault : sign via Vault transit engine (production alt)
SIGNER_BACKEND=env

# ---- Per-network keys (env backend only) ------------------------------------
# 64-char hex, no 0x prefix. Testnet keys are disposable. Mainnet key MUST be
# a multi-sig owner key, never an EOA acting alone.
PK_DEVELOPMENT=
PK_SHASTA=
PK_NILE=
# PK_MAINNET intentionally not provided here. Mainnet runs through KMS.

# ---- AWS KMS (production signer) -------------------------------------------
AWS_REGION=
KMS_KEY_ID_MAINNET=
KMS_KEY_ID_NILE=

# ---- HashiCorp Vault (alternative production signer) -----------------------
VAULT_ADDR=
VAULT_TOKEN=
VAULT_TRANSIT_KEY_MAINNET=
VAULT_TRANSIT_KEY_NILE=

# ---- TronGrid API ----------------------------------------------------------
# Get a free key at https://www.trongrid.io. Required for production-rate
# event indexing.
TRONGRID_API_KEY=

# ---- Indexer / reconciliation ---------------------------------------------
INDEXER_DB_URL=sqlite:///./indexer.db
INDEXER_POLL_INTERVAL_SECONDS=5

# ---- Deployed contract addresses (populated post-deploy) -------------------
TOKEN_ADDRESS_SHASTA=
TOKEN_ADDRESS_NILE=
TOKEN_ADDRESS_MAINNET=
TIMELOCK_ADDRESS_MAINNET=
ALLOWLIST_ADDRESS_MAINNET=

# ---- Operational toggles ---------------------------------------------------
# Network the operator tooling targets by default. Mainnet selection requires
# additional confirmation in scripts (see scripts/verify.js).
DEFAULT_NETWORK=shasta
